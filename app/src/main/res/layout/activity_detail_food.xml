<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.DetailFoodActivity">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/alabaster"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/imgFood"
                android:layout_width="match_parent"
                android:layout_height="400dp"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:adjustViewBounds="true"
                android:src="@drawable/pizza1"/>

           <LinearLayout
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:orientation="horizontal">
               <TextView
                   android:id="@+id/txtFoodName"
                   android:layout_width="0dp"
                   android:layout_weight="1"
                   android:layout_height="wrap_content"
                   android:text="@string/title"
                   android:textSize="24sp"
                   android:textStyle="bold"
                   android:maxLines="2"
                   android:ellipsize="end"
                   android:layout_marginTop="24dp"
                   android:layout_marginEnd="16dp"
                   android:layout_marginStart="12dp"/>
               <TextView
                   android:id="@+id/txtFoodPrice"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:text="@string/example_price"
                   android:textSize="24sp"
                   android:textStyle="bold"
                   android:layout_marginTop="24dp"
                   android:layout_marginEnd="12dp"
                   android:textColor="@color/red"/>
           </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="12dp"
                android:layout_marginStart="12dp"
                android:gravity="center_vertical">

                <RatingBar
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:numStars="5"
                    android:progressTint="@color/orange"
                    android:rating="5.0"
                    android:stepSize="0.1"
                    style="@style/Widget.AppCompat.RatingBar.Indicator"/>

                <TextView
                    android:layout_marginStart="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/five_stars"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/des_food_detail"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginBottom="10dp"/>

                <TextView
                    android:id="@+id/txtFoodDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Trong thế giới hiện đại, nơi thời gian là tài sản quý giá, việc thưởng thức một ly cà phê ngon không chỉ là thói quen mà còn là nghệ thuật. AromaMaster Pro 9000 ra đời để phục vụ những tín đồ cà phê khó tính nhất, mang đến trải nghiệm pha chế chuyên nghiệp ngay tại nhà hoặc văn phòng. Với thiết kế tối giản nhưng tinh tế, tích hợp công nghệ chiết xuất áp suất cao và hệ thống tùy chỉnh hương vị, sản phẩm này không chỉ là một thiết bị mà còn là người bạn đồng hành trong hành trình khám phá cà phê."
                    android:textSize="16sp"
                    android:maxLines="7"
                    android:ellipsize="end"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Số lượng:"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginBottom="10dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_horizontal"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imgMinusQuantity"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="8dp"
                        android:src="@drawable/baseline_remove_24"
                        android:background="@drawable/rectangle_bg"
                        app:tint="@color/white" />

                    <EditText
                        android:id="@+id/edtQuantity"
                        android:layout_width="70dp"
                        android:layout_height="48dp"
                        android:background="@drawable/stroke_bg"
                        android:gravity="center"
                        android:layout_marginHorizontal="16dp"
                        android:inputType="none"
                        android:focusable="false"
                        android:text="@string/start_quantity"/>

                    <ImageView
                        android:id="@+id/imgAddQuantity"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="8dp"
                        android:src="@drawable/baseline_add_24"
                        android:background="@drawable/rectangle_bg"
                        app:tint="@color/white" />
                </LinearLayout>
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="200dp"/>
        </LinearLayout>

    </ScrollView>

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@drawable/baseline_arrow_back_24"
        android:background="@drawable/circle_white_bg"
        android:layout_gravity="top|start"
        android:layout_marginTop="48dp"
        android:layout_marginStart="16dp"
        app:tint="@color/neutral_600" />

    <ImageButton
        android:id="@+id/btnLike"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@drawable/ic_heart_outline"
        android:background="@drawable/circle_white_bg"
        android:layout_gravity="top|end"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="16dp"
        app:tint="@color/red" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraint"
        android:layout_gravity="bottom"
        android:paddingBottom="48dp"
        android:elevation="6dp"
        android:background="@drawable/bottom_menu_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/linear1"
            android:layout_marginTop="32dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toTopOf="@+id/constraint"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/total_price"
                android:layout_weight="1"
                android:textStyle="bold"
                android:textSize="16sp"/>

            <TextView
                android:id="@+id/txtTotalPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/example_price"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="@color/red"
                android:textStyle="bold"
                android:textSize="20sp"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/linear2"
            android:layout_marginTop="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/linear1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnAddToCart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_marginEnd="8dp"
                android:background="@drawable/rectangle_orange_bg"
                android:text="@string/add_to_cart"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnBuyNow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textStyle="bold"
                android:layout_marginStart="8dp"
                android:textColor="@color/white"
                android:background="@drawable/rectangle_bg"
                android:text="@string/check_out_now"/>

        </LinearLayout>




    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_marginVertical="12dp"
    android:layout_marginHorizontal="8dp"
    android:elevation="4dp"
    android:background="@drawable/white_background"
    android:layout_height="110dp">

    <ImageView
        android:id="@+id/imgFood"
        android:layout_width="123dp"
        android:layout_height="match_parent"
        android:background="@drawable/white_background"
        android:clipToOutline="true"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:srcCompat="@tools:sample/avatars" />

    <TextView
        android:id="@+id/txtName"
        android:layout_width="0dp"
        android:maxWidth="180dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:text="@string/title"
        android:textStyle="bold"
        android:textSize="18sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:background="@drawable/white_background"
        android:textColor="@color/black"
        app:layout_constraintEnd_toStartOf="@id/constraintDelete"
        app:layout_constraintStart_toEndOf="@+id/imgFood"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imgStarRate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="@+id/txtName"
        app:layout_constraintTop_toBottomOf="@+id/txtName"
        app:srcCompat="@drawable/baseline_star_24" />

    <TextView
        android:id="@+id/txtFiveStar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/five_star_rate"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/imgStarRate"
        app:layout_constraintStart_toEndOf="@+id/imgStarRate"
        app:layout_constraintTop_toTopOf="@+id/imgStarRate" />

    <TextView
        android:id="@+id/txtPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/zero_price"
        android:textColor="@color/red"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/imgStarRate"
        app:layout_constraintTop_toBottomOf="@+id/imgStarRate" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintDelete"
        android:layout_width="44dp"
        android:layout_height="40dp"
        android:background="@drawable/red_corner_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/baseline_delete_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>